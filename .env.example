# ==========================================================
#  LogSonar — configuration (copiez ce fichier en .env)
#  Les notifications et les seuils se règlent dans l'interface.
# ==========================================================

# Nom affiché dans l'interface et les notifications
LOGSONAR_INSTANCE_NAME=LogSonar

# Fuseau horaire (rapports quotidiens, scans planifiés)
TZ=Europe/Paris

# Port local de l'interface (docker-compose.yml)
LOGSONAR_PORT=8081

# Réseau du reverse proxy existant (docker-compose.proxy.yml uniquement)
# PROXY_NETWORK=monprojet_default

# --- Sécurité ------------------------------------------------
# Adresses/réseaux de VOTRE reverse proxy. X-Forwarded-For n'est lu que pour eux,
# sinon n'importe qui pourrait se faire passer pour une autre IP.
# Ex. : 172.16.0.0/12  (réseaux Docker)
LOGSONAR_TRUSTED_PROXIES=

# Cookies "Secure" : auto (si HTTPS détecté), 1 (toujours), 0 (jamais — dev local)
LOGSONAR_SECURE_COOKIES=auto
LOGSONAR_SESSION_HOURS=12

# --- Détection -----------------------------------------------
# IP/CIDR jamais signalées (vos IP d'administration, outils de monitoring)
LOGSONAR_WHITELIST_IPS=
# Domaines vers lesquels une redirection est légitime (votre domaine)
LOGSONAR_ALLOWED_REDIRECT_DOMAINS=
# Sous-chaînes de logs APPLICATIFS (non HTTP) à ignorer (bruit de BDD, etc.)
LOGSONAR_IGNORE_LOG_SUBSTRINGS=checkpoint starting,checkpoint complete

# --- Rétention -----------------------------------------------
LOGSONAR_RETENTION_DAYS=90
LOGSONAR_METRICS_RETENTION_DAYS=14

# --- Scan de vulnérabilités ----------------------------------
# Heure du scan quotidien automatique
LOGSONAR_VULN_SCAN_HOUR=3
# Scanner aussi les paquets du serveur hôte
LOGSONAR_SCAN_HOST=1
